# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Model used by the orchestrator and all worker agents (default: gemini-2.5-flash-lite)
MODEL_NAME=gemini-2.5-flash-lite

# Total token budget per swarm run.
#   None / unlimited / empty  -> any amount of usage is permitted (default)
#   a number (e.g. 500000)    -> soft ceiling: no new work starts once it is reached and the
#                                remaining tickets are marked BLOCKED (TOKEN_BUDGET_EXHAUSTED)
TOKEN_USAGE_LIMIT=None

# Project directory the agents edit IN PLACE (absolute path). Never copy projects into this repo.
# Can be overridden per call with the `workspace` argument (MCP) or --workspace (CLI).
# TARGET_WORKSPACE=C:\path\to\your\project

# Maximum number of agents launched in the worker swarm (default: 3)
# The first N-1 agents are Worker Agents (analysis, coding, refactor, docs).
# The Nth agent (Agent-N) is ALWAYS the dedicated QA & Test Verification Engineer.
MAX_AGENTS=5

# Strict maximum number of tickets queued per agent at any given time (default: 3)
QUEUE_LIMIT_PER_AGENT=3

# Multi-Agent Parallel Execution (default: true)
# When true, idle agents execute tickets concurrently in parallel via thread pool.
SWARM_PARALLEL=true

# Automated QA Tester strategy (default: true)
# When true, completed code changes automatically trigger the Nth agent to test and verify changes.
AUTO_QA_TESTER=true

# Optional comma-separated agent names (defaults to Agent-1, Agent-2, ...)
# AGENT_NAMES=Atlas,Forge,Sentinel,Mason,Scribe

# Tool-call rounds a worker may use per ticket before failing with ITERATION_LIMIT (default: 20)
MAX_WORKER_ITERATIONS=20

# Allow workers to run git commit/push/pull/branch (default: false; the Brain does git writes)
AGENT_GIT_WRITE_TOOLS=false

# Where run logs (events.jsonl, summary.json, runs_index.jsonl) are written
# (default: <swarm repo>/logs/swarm)
# SWARM_LOG_DIR=logs/swarm
